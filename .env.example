# Optional: role-aware Scout chat, social script drafts, and SEO suggestions.
# Keep real keys in .env or your host's secret settings. Never commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Meta Ads read-only daily spend sync. The token needs ads_read access.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v25.0

# Optional Google Ads read-only reporting sync. Developer token is required.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Only for access through a manager account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26
